{
  "name": "webprobe",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch --env-file-if-exists=.env apps/server/src/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run typecheck && vite build",
    "start": "tsx --env-file-if-exists=.env apps/server/src/index.ts",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "test:security": "tsx --test tests/security.test.ts",
    "test:e2e": "tsx tests/e2e.ts && tsx tests/testing-e2e.ts",
    "verify": "node .ai-workflow/verify.mjs --risk medium",
    "verify:high": "node .ai-workflow/verify.mjs --risk high",
    "workflow:doctor": "node scripts/workflow-doctor.mjs",
    "browsers": "playwright install chromium firefox webkit",
    "scan": "tsx --env-file-if-exists=.env apps/server/src/cli.ts",
    "demo": "tsx fixtures/site.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@hono/node-server": "^2.1.11",
    "chrome-launcher": "^1.0.0",
    "fflate": "^0.8.2",
    "hono": "^4.7.0",
    "ipaddr.js": "^2.2.0",
    "lighthouse": "^13.6.0",
    "lucide-vue-next": "^1.0.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.56.1",
    "pngjs": "^7.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^9.1.2",
    "prettier": "^3.10.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
